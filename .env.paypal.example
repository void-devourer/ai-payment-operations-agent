# Copy to .env.paypal. This profile is separate from the existing simulator .env.
# All identifiers and credentials must belong to your PayPal SANDBOX seller app.
PAYPAL_ENABLED=1
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WORKSPACE_A_CLIENT_ID=
PAYPAL_WORKSPACE_A_CLIENT_SECRET=
PAYPAL_WORKSPACE_A_MERCHANT_ID=
# Optional for invoicing/status polling. Required to enable verified webhooks.
PAYPAL_WORKSPACE_A_WEBHOOK_ID=
# Workspace B is optional; use a distinct seller, app and destination if enabled.
PAYPAL_WORKSPACE_B_CLIENT_ID=
PAYPAL_WORKSPACE_B_CLIENT_SECRET=
PAYPAL_WORKSPACE_B_MERCHANT_ID=
PAYPAL_WORKSPACE_B_WEBHOOK_ID=
