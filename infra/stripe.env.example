# Copy to .env.stripe and fill locally; never paste credentials into chat or Git.
# STRIPE_ENABLED=0 preserves the independent simulator.
STRIPE_ENABLED=0
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_WORKSPACE_A_ACCOUNT_ID=
STRIPE_WORKSPACE_A_READ_KEY=
STRIPE_WORKSPACE_A_WEBHOOK_SECRET=
# Optional second distinct sandbox; never share one account across workspaces.
STRIPE_WORKSPACE_B_ACCOUNT_ID=
STRIPE_WORKSPACE_B_READ_KEY=
STRIPE_WORKSPACE_B_WEBHOOK_SECRET=
