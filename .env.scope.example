# Copy to .env.scope (ignored). Optional: the curated sample needs no API key.
# Explicit provider; there is no automatic fallback to a paid provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional legacy OpenAI configuration (used only with AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=
